<div id="site">
<header class="site-header">
  <div class="container">
    <a class="brand" href="#home" aria-label="Endeavour International School, home">
      <svg width="40" height="40" viewBox="0 0 64 64" aria-hidden="true"><rect width="64" height="64" rx="14" fill="#12284A"/><path d="M14 54V30a18 18 0 0 1 36 0v24" fill="none" stroke="#C5A059" stroke-width="3.5"/><path d="M22 54V32a10 10 0 0 1 20 0v22" fill="none" stroke="#C5A059" stroke-opacity=".5" stroke-width="2"/><circle cx="32" cy="40" r="6.5" fill="#FFD700"/><path d="M10 54h44" stroke="#C5A059" stroke-width="3.5" stroke-linecap="round"/></svg>
      <span class="brand-text"><span class="brand-name">Endeavour</span><span class="brand-sub">International School</span></span>
    </a>
    <nav class="nav" aria-label="Main">
      <ul class="nav-links" id="nav-links">
        <li><a href="#home">Home</a></li>
        <li><a href="#about">About</a></li>
        <li><a href="#academics">Academics</a></li>
        <li><a href="#campus">Campus life</a></li>
        <li><a href="#dates">Key dates</a></li>
        <li><a href="#contact">Contact</a></li>
