    const f = firstFocusable(errors[0]);
    if(f.scrollIntoView) f.scrollIntoView({block:'center', behavior: reduceMotion() ? 'auto' : 'smooth'});
    return;
  }
  status.textContent = '';
  const btn = $('#submit-btn'); btn.disabled = true; btn.textContent = 'Sending\u2026';
  const lead = {
    id: newTrackingId(),
    createdAt: new Date().toISOString(),
    status: 'Pending',
    parent: getVal('parent').trim(),
