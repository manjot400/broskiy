<script>
(() => {
'use strict';

/* ==========================================================================
   Helpers
   ========================================================================== */
const $  = (s, r = document) => r.querySelector(s);
const $$ = (s, r = document) => Array.from(r.querySelectorAll(s));
const esc = s => String(s ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const fmtDate = (d, o) => new Date(d).toLocaleDateString('en-IN', o || {day:'numeric', month:'short', year:'numeric'});
const fmtDateTime = d => new Date(d).toLocaleString('en-IN', {day:'numeric', month:'short', year:'numeric', hour:'numeric', minute:'2-digit'});
const reduceMotion = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;
const icon = (id, size = 26) => `<svg width="${size}" height="${size}" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="#${id}"/></svg>`;

function toast(msg){
  const el = document.createElement('div');
  el.className = 'toast'; el.textContent = msg;
  /* Modal dialogs sit in the top layer, so show the toast inside the open one */
  const dlg = document.querySelector('dialog[open]');
  let host = $('#toasts');
  if(dlg){ host = dlg.querySelector('.toasts') || dlg.appendChild(Object.assign(document.createElement('div'), {className:'toasts'})); }
  host.appendChild(el);
  setTimeout(() => { el.style.transition = 'opacity .3s'; el.style.opacity = '0'; setTimeout(() => el.remove(), 320); }, 3200);
}

/* ==========================================================================
   Admission session (drives dates and the grade suggestion)
   Session starts 1 April. From April onwards we look at next year's session.
   ========================================================================== */
const NOW = new Date();
const SESSION_YEAR = NOW.getMonth() >= 3 ? NOW.getFullYear() + 1 : NOW.getFullYear();
const SESSION_LABEL = `${SESSION_YEAR}\u2013${String(SESSION_YEAR + 1).slice(2)}`;
const CUTOFF = new Date(SESSION_YEAR, 2, 31);          // age is counted on 31 March of the session year
const CUTOFF_TEXT = fmtDate(CUTOFF, {day:'numeric', month:'long', year:'numeric'});

$('#admissions-pill').textContent = `Admissions open for the ${SESSION_LABEL} session`;
$('#copyright').innerHTML = `&copy; ${NOW.getFullYear()} Endeavour International School. All rights reserved.`;

/* ==========================================================================
   Storage (localStorage with in-memory fallback)
   ========================================================================== */
const KEY = 'endeavour.enquiries.v1';
let memStore = null;
const Store = {
  read(){
    try{ const raw = localStorage.getItem(KEY); return raw ? JSON.parse(raw) : (memStore || []); }
    catch(e){ return memStore || []; }
  },
  write(list){
    try{ localStorage.setItem(KEY, JSON.stringify(list)); memStore = null; }
    catch(e){ memStore = list; }
    document.dispatchEvent(new CustomEvent('leads:changed'));
  },
  add(lead){ const l = this.read(); l.unshift(lead); this.write(l); },
  update(id, patch){ const l = this.read(); const i = l.findIndex(x => x.id === id); if(i > -1){ l[i] = {...l[i], ...patch}; this.write(l); } },
  remove(id){ this.write(this.read().filter(x => x.id !== id)); },
  clear(){ this.write([]); },
  find(id){ return this.read().find(x => x.id.toUpperCase() === String(id).trim().toUpperCase()); }
};
window.addEventListener('storage', e => { if(e.key === KEY) document.dispatchEvent(new CustomEvent('leads:changed')); });

function newTrackingId(){
  const A = 'ABCDEFGHJKMNPQRSTUVWXYZ23456789';
  const existing = new Set(Store.read().map(l => l.id));
  let id;
  do{
    let s = ''; const arr = new Uint32Array(6);
    (window.crypto || {getRandomValues: a => a.map(() => Math.random() * 4294967296)}).getRandomValues(arr);
    arr.forEach(n => s += A[n % A.length]);
    id = `END-${String(SESSION_YEAR).slice(2)}-${s}`;
  }while(existing.has(id));
  return id;
}

/* ==========================================================================
   Theme
   ========================================================================== */
const root = document.documentElement;
function setTheme(t, animate){
  if(animate && !reduceMotion()){ root.classList.add('theme-anim'); setTimeout(() => root.classList.remove('theme-anim'), 500); }
  root.setAttribute('data-theme', t);
  try{ localStorage.setItem('endeavour.theme', t); }catch(e){}
  $$('.theme-toggle').forEach(b => {
    b.setAttribute('aria-pressed', String(t === 'dark'));
    b.setAttribute('aria-label', t === 'dark' ? 'Switch to light mode' : 'Switch to dark mode');
  });
}
setTheme(root.getAttribute('data-theme') || 'light', false);
$$('.theme-toggle').forEach(b => b.addEventListener('click', () => setTheme(root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark', true)));

/* ==========================================================================
   Navigation: mobile menu and scroll spy
   ========================================================================== */
const menuBtn = $('#menu-btn'), navLinks = $('#nav-links');
function setMenu(open){
  navLinks.classList.toggle('open', open);
  menuBtn.setAttribute('aria-expanded', String(open));
  menuBtn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
}
menuBtn.addEventListener('click', () => setMenu(!navLinks.classList.contains('open')));
$$('a', navLinks).forEach(a => a.addEventListener('click', () => setMenu(false)));
document.addEventListener('keydown', e => { if(e.key === 'Escape' && navLinks.classList.contains('open')){ setMenu(false); menuBtn.focus(); } });

const spyIds = ['home','about','academics','campus','dates','contact'];
const spyMap = new Map(spyIds.map(id => [id, $(`.nav-links a[href="#${id}"]`)]));
if('IntersectionObserver' in window){
  const io = new IntersectionObserver(entries => {
    entries.forEach(en => {
      if(en.isIntersecting){
        spyMap.forEach(a => a && a.removeAttribute('aria-current'));
        const a = spyMap.get(en.target.id); if(a) a.setAttribute('aria-current', 'true');
      }
    });
  }, {rootMargin:'-45% 0px -50% 0px'});
  spyIds.forEach(id => { const el = document.getElementById(id); if(el) io.observe(el); });
}

/* ==========================================================================
   Facilities and clubs
   ========================================================================== */
const TILES = [
  {k:'Facility', i:'i-board',  t:'Smart classrooms', d:'Interactive displays that make lessons visual, and rooms sized for 25 students at most.'},
  {k:'Facility', i:'i-flask',  t:'Science and computer labs', d:'Hands-on experiments and screen time with purpose, supervised by teachers.'},
  {k:'Facility', i:'i-book',   t:'Library', d:'A quiet place to read, research and borrow books for the week.'},
  {k:'Facility', i:'i-field',  t:'Sports ground', d:'Open space for games, athletics and the daily play every child needs.'},
  {k:'Facility', i:'i-music',  t:'Music and art room', d:'A dedicated room for instruments, colours and creative work.'},
  {k:'Facility', i:'i-bus',    t:'School bus service', d:'Routes across Bhopal, so getting to school is one less worry.'},
  {k:'Club',     i:'i-debate', t:'Debate', d:'Learn to build an argument, listen closely and speak with confidence.'},
  {k:'Club',     i:'i-globe',  t:'Model United Nations', d:'Represent a country, negotiate with peers and see the world from other seats.'},
  {k:'Club',     i:'i-code',   t:'Coding', d:'Turn ideas into working programs, step by step.'},
