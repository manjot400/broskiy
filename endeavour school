function filtered(){
  return Store.read().filter(l =>
    (af.grade === 'all' || String(l.grade) === af.grade) &&
    (af.status === 'all' || l.status === af.status) &&
    (!af.q || [l.parent, l.child, l.email, l.phone, l.id].some(v => String(v).toLowerCase().includes(af.q)))
  ).sort((a, b) => new Date(b.createdAt) - new Date(a.createdAt));
}

function renderAdmin(){ renderStats(); renderTable(); }

function renderStats(){
  const all = Store.read();
  const c = {Pending:0, Contacted:0, Enrolled:0};
  all.forEach(l => { if(c[l.status] !== undefined) c[l.status]++; });
  const total = all.length;
  const rate = total ? Math.round(c.Enrolled / total * 100) : 0;
  $('#kpis').innerHTML = `
    <div class="kpi"><small>Total enquiries</small><strong>${total}</strong><span>For the ${SESSION_LABEL} session</span></div>
    <div class="kpi"><small>Pending</small><strong>${c.Pending}</strong><span>Waiting for a first call</span></div>
    <div class="kpi"><small>Contacted</small><strong>${c.Contacted}</strong><span>In conversation</span></div>
    <div class="kpi"><small>Enrolled</small><strong>${c.Enrolled}</strong><span>${rate}% of all enquiries</span></div>`;
  const pct = n => total ? (n / total * 100) : 0;
  $('#pipe').innerHTML = `<i class="p-pending" style="width:${pct(c.Pending)}%"></i><i class="p-contacted" style="width:${pct(c.Contacted)}%"></i><i class="p-enrolled" style="width:${pct(c.Enrolled)}%"></i>`;
  $('#pipe').setAttribute('aria-label', `Pipeline: ${c.Pending} pending, ${c.Contacted} contacted, ${c.Enrolled} enrolled`);
  $('#legend').innerHTML = `<span><i style="background:#E0A526"></i>Pending ${c.Pending}</span><span><i style="background:#3B82F6"></i>Contacted ${c.Contacted}</span><span><i style="background:#22A06B"></i>Enrolled ${c.Enrolled}</span>`;
  const byGrade = Array(13).fill(0); all.forEach(l => { if(l.grade >= 1 && l.grade <= 12) byGrade[l.grade]++; });
  const max = Math.max(1, ...byGrade);
  $('#bars').innerHTML = byGrade.slice(1).map((n, i) => `<div class="bar" title="Grade ${i + 1}: ${n}"><b>${n || ''}</b><i style="height:${n ? Math.max(6, n / max * 82) : 3}px"></i><span>G${i + 1}</span></div>`).join('');
}

