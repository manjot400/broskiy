/* CSV export (respects current search and filters) */
function csvCell(v){
  let s = String(v ?? '');
  if(/^[=+\-@\t\r]/.test(s)) s = "'" + s;      // neutralise spreadsheet formula injection
  return '"' + s.replace(/"/g, '""') + '"';
}
$('#a-export').addEventListener('click', () => {
  const rows = filtered();
  if(!rows.length){ toast('Nothing to export with the current filters'); return; }
  const head = ['Tracking ID','Submitted at','Status','Parent or guardian','Email','Phone','Child','Date of birth','Grade','Previous school','Heard via','Message','Consent'];
  const lines = [head.map(csvCell).join(',')].concat(rows.map(l => [l.id, l.createdAt, l.status, l.parent, l.email, l.phone, l.child, l.dob, `Grade ${l.grade}`, l.school, l.hear, l.message, l.consent ? 'Yes' : 'No'].map(csvCell).join(',')));
  const blob = new Blob(['\ufeff' + lines.join('\r\n')], {type:'text/csv;charset=utf-8'});
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url; a.download = `endeavour-enquiries-${todayISO}.csv`;
  document.body.appendChild(a); a.click(); a.remove();
  setTimeout(() => URL.revokeObjectURL(url), 1000);
  toast(`Exported ${rows.length} ${rows.length === 1 ? 'enquiry' : 'enquiries'} to CSV`);
});

