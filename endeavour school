function confirmBox(title, msg, yesLabel){
  return new Promise(res => {
    $('#confirm-title').textContent = title; $('#confirm-msg').textContent = msg; $('#confirm-yes').textContent = yesLabel || 'Confirm';
    const done = v => { confirmDlg.close(); $('#confirm-yes').onclick = $('#confirm-no').onclick = null; confirmDlg.onclose = null; res(v); };
    $('#confirm-yes').onclick = () => done(true);
    $('#confirm-no').onclick = () => done(false);
    confirmDlg.onclose = () => res(false);
    confirmDlg.showModal(); $('#confirm-no').focus();
  });
}

