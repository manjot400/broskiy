/* Smart grade suggestion from date of birth */
let gradeManual = false;
function suggestGrade(){
  const hint = $('#hint-dob');
  const v = $('#f-dob').value;
  const g = gradeFromDob(v);
  hint.classList.remove('good');
  if(!v){ hint.textContent = 'We will suggest a grade from the date of birth.'; return; }
  if(!g){ hint.textContent = 'We will suggest a grade once the date is complete.'; return; }
  if(g.grade < 1 || g.grade > 12){ hint.textContent = ''; return; }
  const sug = String(g.grade);
  if(!gradeManual || !gradeSel.value){
    gradeSel.value = sug; gradeManual = false;
    if(touched.grade) validateField('grade');
    hint.classList.add('good');
    hint.textContent = `Grade ${sug} selected from the date of birth (age ${g.age} on ${CUTOFF_TEXT}). You can change it.`;
  }else if(gradeSel.value !== sug){
    hint.innerHTML = `Suggested for the date of birth: Grade ${sug} (age ${g.age} on ${esc(CUTOFF_TEXT)}).<button type="button" class="link-btn" id="use-suggestion">Use Grade ${sug}</button>`;
    $('#use-suggestion').addEventListener('click', () => {
      gradeSel.value = sug; gradeManual = false; validateField('grade'); suggestGrade(); gradeSel.focus();
    });
  }else{
    hint.classList.add('good');
    hint.textContent = `Matches the suggested grade for this date of birth (age ${g.age} on ${CUTOFF_TEXT}).`;
  }
}

form.addEventListener('submit', e => {
  e.preventDefault();
  const errors = FIELD_ORDER.filter(n => { touched[n] = true; return validateField(n); });
  const status = $('#form-status');
  if(errors.length){
    status.textContent = errors.length === 1 ? 'One field needs your attention. It is marked below.' : `${errors.length} fields need your attention. They are marked below.`;
