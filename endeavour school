    </article>`).join('');
}
renderTiles();
$$('.chip-btn').forEach(b => b.addEventListener('click', () => {
  $$('.chip-btn').forEach(x => x.setAttribute('aria-pressed', String(x === b)));
  renderTiles(b.dataset.filter);
}));

/* ==========================================================================
   Sliders (gallery and testimonials)
   ========================================================================== */
class Slider{
  constructor(root){
    this.root = root;
    this.track = $('.slider-track', root);
    this.slides = $$('.slide', this.track);
    this.dotsEl = $('[data-dots]', root);
    this.i = 0;
    this.dotsEl.innerHTML = this.slides.map((_, n) => `<button type="button" aria-label="Go to slide ${n + 1}"></button>`).join('');
    this.dots = $$('button', this.dotsEl);
    this.dots.forEach((d, n) => d.addEventListener('click', () => this.go(n)));
    $('[data-prev]', root).addEventListener('click', () => this.go(this.i - 1));
    $('[data-next]', root).addEventListener('click', () => this.go(this.i + 1));
    root.addEventListener('keydown', e => {
      if(e.key === 'ArrowLeft'){ this.go(this.i - 1); }
      if(e.key === 'ArrowRight'){ this.go(this.i + 1); }
    });
    let x0 = null;
    const vp = $('.slider-viewport', root);
    vp.addEventListener('pointerdown', e => { x0 = e.clientX; });
    vp.addEventListener('pointerup', e => {
      if(x0 === null) return;
      const dx = e.clientX - x0; x0 = null;
      if(Math.abs(dx) > 45) this.go(this.i + (dx < 0 ? 1 : -1));
    });
    vp.addEventListener('pointercancel', () => { x0 = null; });
    this.go(0);
  }
  go(n){
    const len = this.slides.length;
    this.i = (n + len) % len;
    this.track.style.transform = `translateX(${-this.i * 100}%)`;
    this.slides.forEach((s, k) => {
      const active = k === this.i;
      s.setAttribute('aria-hidden', String(!active));
      s.inert = !active;
      s.setAttribute('role', 'group');
      s.setAttribute('aria-roledescription', 'slide');
      s.setAttribute('aria-label', `${k + 1} of ${len}`);
    });
    this.dots.forEach((d, k) => d.setAttribute('aria-current', String(k === this.i)));
  }
}

const SCENES = [
  {i:'i-board',  t:'Smart classroom',    d:'Lessons on a shared screen, in a room built for small groups.', c:['#1B3A66','#0B192C']},
  {i:'i-flask',  t:'Science laboratory', d:'Experiments that turn textbook ideas into things children can see.', c:['#17406B','#0B192C']},
  {i:'i-field',  t:'Sports ground',      d:'Room to run, play and learn how to win and lose well.', c:['#1F4A4F','#0B192C']},
  {i:'i-music',  t:'Music and art room', d:'A bright room for instruments, paint and clay.', c:['#2B2F63','#0B192C']},
  {i:'i-book',   t:'Library',            d:'Shelves, quiet corners and a reading habit that lasts.', c:['#1F3560','#0B192C']}
];
function sceneSvg(s, n){
  return `<svg viewBox="0 0 800 450" role="img" aria-label="Placeholder image: ${esc(s.t)}">
    <defs><linearGradient id="g${n}" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="${s.c[0]}"/><stop offset="1" stop-color="${s.c[1]}"/></linearGradient></defs>
    <rect width="800" height="450" fill="url(#g${n})"/>
    <g fill="none" stroke="#C5A059" stroke-opacity=".25" stroke-width="2"><circle cx="680" cy="80" r="150"/><circle cx="680" cy="80" r="110"/><path d="M0 380h800M0 410h800"/></g>
    <g transform="translate(400 215) scale(8) translate(-12 -12)" fill="none" stroke="#FFD700" stroke-width=".7" stroke-linecap="round" stroke-linejoin="round"><use href="#${s.i}"/></g>
  </svg>`;
}
$('#gallery-track').innerHTML = SCENES.map((s, n) => `
  <div class="slide"><figure>${sceneSvg(s, n)}<figcaption><strong>${esc(s.t)}</strong>${esc(s.d)}</figcaption></figure></div>`).join('');

const TESTI = [
  {q:'In the first meeting, the principal asked about our daughter before he talked about the school. That told us a lot.', a:'Parent of a Grade 3 applicant'},
  {q:'A class of 25 and one teacher for every 15 students is the reason we chose Endeavour. Our son will not be lost in a crowd.', a:'Parent of a Grade 7 applicant'},
  {q:'We wanted a CISCE school with real activities, not just exam preparation. Robotics and debate sealed it for us.', a:'Parent of a Grade 9 applicant'}
];
$('#testi-track').innerHTML = TESTI.map(t => `<div class="slide"><blockquote>\u201C${esc(t.q)}\u201D</blockquote><cite>${esc(t.a)}</cite></div>`).join('');
new Slider($('#gallery'));
new Slider($('#testimonials'));

/* ==========================================================================
   Admission timeline (state computed from today's date)
   ========================================================================== */
const STEPS = [
  {d:new Date(SESSION_YEAR - 1, 9, 1),  t:'Enquiries open',                 p:'Send an enquiry using the form below. It is the first step for every family.'},
  {d:new Date(SESSION_YEAR - 1, 10, 15),t:'Campus visits and parent meetings', p:'Meet the principal, see the classrooms and ask your questions in person.'},
  {d:new Date(SESSION_YEAR, 0, 10),     t:'Student interaction',            p:'A relaxed conversation with your child so we can place them in the right grade.'},
  {d:new Date(SESSION_YEAR, 1, 1),      t:'Offers announced',               p:'Families receive an admission decision by phone and email.'},
  {d:new Date(SESSION_YEAR, 2, 1),      t:'Admission confirmed',            p:'Complete documents and fees to secure your child\u2019s place.'},
  {d:new Date(SESSION_YEAR, 3, 1),      t:'Session begins',                 p:'The first day of the new academic year.'}
];
(function renderTimeline(){
  let cur = -1; STEPS.forEach((s, i) => { if(s.d <= NOW) cur = i; });
  $('#timeline').innerHTML = STEPS.map((s, i) => {
    const state = i < cur ? 'done' : i === cur ? 'current' : '';
    const mark = i < cur ? '\u2713' : String(i + 1);
    return `<li class="tl-item ${state}" ${i === cur ? 'aria-current="step"' : ''}>
      <div class="tl-date">${fmtDate(s.d, {day:'numeric', month:'short', year:'numeric'})}</div>
      <div class="tl-mark"><span class="tl-dot" aria-hidden="true">${mark}</span></div>
      <div class="tl-body"><h3>${esc(s.t)}${i === cur ? '<span class="tl-now">Happening now</span>' : ''}</h3><p>${esc(s.p)}</p></div>
    </li>`;
  }).join('');
})();

/* ==========================================================================
   Enquiry form
   ========================================================================== */
const form = $('#enquiry-form');
const gradeSel = $('#f-grade');
gradeSel.innerHTML = '<option value="">Select a grade</option>' + Array.from({length:12}, (_, i) => `<option value="${i + 1}">Grade ${i + 1}</option>`).join('');

const todayISO = (() => { const d = new Date(); return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`; })();
$('#f-dob').max = todayISO;
$('#f-dob').min = `${NOW.getFullYear() - 25}-01-01`;

const NAME_RE  = /^[\p{L}][\p{L}\p{M}\s.'\u2019-]{1,59}$/u;
const EMAIL_RE = /^(?!.*\.\.)[A-Za-z0-9._%+'-]+@[A-Za-z0-9-]+(\.[A-Za-z0-9-]+)*\.[A-Za-z]{2,}$/;

function parseDob(v){
  if(!/^\d{4}-\d{2}-\d{2}$/.test(v)) return null;
  const [y, m, d] = v.split('-').map(Number);
  const dt = new Date(y, m - 1, d);
  return (dt.getFullYear() === y && dt.getMonth() === m - 1 && dt.getDate() === d) ? dt : null;
}
function ageAt(dob, ref){
  let a = ref.getFullYear() - dob.getFullYear();
  const m = ref.getMonth() - dob.getMonth();
  if(m < 0 || (m === 0 && ref.getDate() < dob.getDate())) a--;
  return a;
}
/* Grade by age on 31 March of the session year: age 6 enters Grade 1 */
function gradeFromDob(v){
  const dob = parseDob(v); if(!dob || dob > NOW) return null;
  const age = ageAt(dob, CUTOFF);
  return {age, grade: age - 5};
}

const getVal = name => {
  if(name === 'hear')    return (form.querySelector('input[name="hear"]:checked') || {}).value || '';
  if(name === 'consent') return $('#f-consent').checked ? 'yes' : '';
  return form.elements[name].value;
};

const VALIDATORS = {
  parent(v){
    v = v.trim();
    if(!v) return 'Enter the parent or guardian\u2019s name.';
    if(!NAME_RE.test(v)) return 'Use letters only (spaces, dots, hyphens and apostrophes are fine), 2 to 60 characters.';
    return '';
  },
  child(v){
    v = v.trim();
    if(!v) return 'Enter your child\u2019s name.';
    if(!NAME_RE.test(v)) return 'Use letters only (spaces, dots, hyphens and apostrophes are fine), 2 to 60 characters.';
    return '';
  },
  dob(v){
    if(!v) return 'Choose your child\u2019s date of birth.';
    const dob = parseDob(v);
    if(!dob) return 'This date is not valid. Use the date picker or the format DD-MM-YYYY.';
    if(dob > NOW) return 'The date of birth cannot be in the future.';
    const g = gradeFromDob(v);
    if(g.grade < 1) return `Grade 1 needs the child to be 6 years old on ${CUTOFF_TEXT}. Your child will be ${g.age}.`;
    if(g.grade > 12) return `This date of birth is above the range for Grades 1 to 12 (child will be ${g.age} on ${CUTOFF_TEXT}).`;
    return '';
  },
  grade(v){ return v ? '' : 'Choose the grade you are applying for.'; },
  email(v){
    v = v.trim();
    if(!v) return 'Enter an email address.';
    if(!EMAIL_RE.test(v)) return 'This email address looks incomplete. Use the format name@example.com.';
    return '';
  },
  phone(v){
    v = v.trim();
    if(!v) return 'Enter a 10-digit phone number.';
    if(/\D/.test(v)) return 'Use digits only, without spaces, dashes or +91.';
    if(v.length !== 10) return `A phone number has 10 digits. You entered ${v.length}.`;
    return '';
  },
  hear(v){ return v ? '' : 'Choose how you heard about us.'; },
  consent(v){ return v ? '' : 'Please tick the box so we can contact you about this enquiry.'; }
};
const FIELD_ORDER = ['parent','child','dob','grade','email','phone','hear','consent'];
const touched = {};

function showError(name, msg){
  const wrap = $(`[data-field="${name}"]`, form);
  const err = $(`#err-${name}`);
  wrap.classList.toggle('has-error', !!msg);
  err.textContent = msg;
  const ctl = name === 'hear' ? $('fieldset', wrap) : name === 'consent' ? $('#f-consent') : $(`#f-${name}`);
  if(name === 'hear') ctl.setAttribute('aria-invalid', msg ? 'true' : 'false');
  else ctl.setAttribute('aria-invalid', msg ? 'true' : 'false');
}
function validateField(name){
  const msg = VALIDATORS[name](getVal(name));
  showError(name, msg);
  return msg;
}
function firstFocusable(name){
  if(name === 'hear') return $('input[name="hear"]', form);
  if(name === 'consent') return $('#f-consent');
  return $(`#f-${name}`);
}

